+roomsRouter.get("/:id/availability", (req, res) => {
+  const room = findRoom(req.params.id);
+  if (!room) {
+    res.status(404).json({ error: "salle inconnue" });
+    return;
+  }
+
+  const date = req.query.date;
+  if (typeof date !== "string") {
+    res.status(400).json({ error: "parametre date manquant : attendu YYYY-MM-DD" });
+    return;
+  }
+
+  const day = parseDay(date);
+  if (!day.ok) {
+    res.status(400).json({ error: day.error });
+    return;
+  }
+
+  const freeSlots = computeFreeSlots(day.value.start, day.value.end, bookingsForRoom(room.id));
+  res.json({ roomId: room.id, date, freeSlots });
+});
